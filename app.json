{
  "expo": {
    "name": "TB Masdar Utama Mobile",
    "slug": "tb-masdarutama-mobile",
    "version": "1.1.1",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/6e4aad91-e3dc-44f4-97f3-0f332f02dd6e",
      "enabled": true,
      "fallbackToCacheTimeout": 0,
      "checkAutomatically": "ON_LOAD"
    },
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "icon": "./assets/logomasdarutama.png",
    "splash": {
      "resizeMode": "contain",
      "backgroundColor": "#0F0F23"
    },
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "versionCode": 3,
      "adaptiveIcon": {
        "foregroundImage": "./assets/logomasdarutama.png",
        "backgroundColor": "#0F0F23"
      },
      "package": "com.tbmasdarutama.mobile",
      "googleServicesFile": "./google-services.json",
      "permissions": [
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT",
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.BLUETOOTH",
        "android.permission.BLUETOOTH_ADMIN",
        "android.permission.BLUETOOTH_CONNECT",
        "android.permission.BLUETOOTH_SCAN",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.VIBRATE",
        "android.permission.RECEIVE_BOOT_COMPLETED",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_BACKGROUND_LOCATION",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_LOCATION",
        "android.permission.REQUEST_INSTALL_PACKAGES",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE"
      ]
    },
    "plugins": [
      "./plugins/withGradleVersion",
      "expo-secure-store",
      "expo-local-authentication",
      "expo-audio",
      "expo-updates",
      "expo-task-manager",
      [
        "expo-notifications",
        {
          "defaultChannel": "masdar_channel_v2",
          "mode": "production",
          "androidMode": "default",
          "androidCollapsedTitle": "TB Masdar Utama",
          "iosDisplayInForeground": true,
          "sounds": [
            "./assets/masdar_utama.mp3"
          ]
        }
      ],
      "@react-native-community/datetimepicker",
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "TB Masdar Utama memerlukan akses lokasi untuk fitur Tracking Armada. Izinkan akses lokasi 'Selalu' agar tracking berjalan saat aplikasi ditutup.",
          "locationAlwaysPermission": "TB Masdar Utama memerlukan akses lokasi di latar belakang untuk melacak armada secara otomatis.",
          "locationWhenInUsePermission": "TB Masdar Utama memerlukan akses lokasi untuk menampilkan posisi armada di peta.",
          "isIosBackgroundLocationEnabled": true,
          "isAndroidBackgroundLocationEnabled": true
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "minSdkVersion": 26,
            "useLegacyPackaging": true,
            "usesCleartextTraffic": true,
            "packagingOptions": {
              "pickFirst": [
                "lib/x86/libc++_shared.so",
                "lib/x86_64/libc++_shared.so",
                "lib/armeabi-v7a/libc++_shared.so",
                "lib/arm64-v8a/libc++_shared.so"
              ]
            }
          },
          "ios": {
            "deploymentTarget": "15.1"
          }
        }
      ],
      "expo-asset"
    ],
    "extra": {
      "eas": {
        "projectId": "6e4aad91-e3dc-44f4-97f3-0f332f02dd6e"
      }
    }
  }
}
